# ---------------------------------------------------------------------------
# Local / self-hosted (SQLite via Prisma — reactions + render-queue rows)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# Vercel / serverless — Upstash Redis (https://upstash.com, free tier works)
# Reactions counters + render-queue rows live in Redis when these are set;
# without them the API degrades gracefully (in-memory counters, and render
# jobs report "unavailable" with an actionable message).
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Vercel / serverless — Remotion Lambda rendering (personalized MP4s)
# https://www.remotion.dev/docs/lambda — requires a Remotion Company license.
# With these set, POST /api/render routes renders through AWS Lambda and
# returns presigned S3 download URLs. Without them, serverless renders
# report "unavailable" (in-browser preview stays fully functional).
# ---------------------------------------------------------------------------
REMOTION_LICENSE_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
REMOTION_SITE_NAME="hyperreel-site"
REMOTION_FUNCTION_NAME="hyperreel-render"
